SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# write_products deckt Varianten, SKU und Produkt-Metafield-Definitionen ab.
SCOPES=write_products
SHOPIFY_APP_URL=
SHOP_CUSTOM_DOMAIN=

# Wurzel des JSON-Exports. Darunter hängt die App selbst <shop>.myshopify.com an.
# Gefilterter Präsent-Export: tools/sage-export/export. Standard hier bleiben die Fixtures.
SYNC_SOURCE_DIR=fixtures
