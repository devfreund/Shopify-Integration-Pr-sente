# Vorlage. Kopie als sage-export.toml anlegen (gitignored) und ausfüllen.
# Passwörter gehören NICHT hierher, sondern in .env (WKF_PWD / DB_PASSWORD).

[sage]
# Entweder eine vorkonfigurierte ODBC-Datenquelle ...
dsn = "WKF_SAGE"

# ... oder Treiber, Server und Datenbank direkt:
# driver = "ODBC Driver 18 for SQL Server"
# server = "sql.intern.wkf"
# database = "OL_WKF"

# Windows-Anmeldung statt Benutzer/Passwort:
# trusted_connection = true
# user = "sage_readonly"

# Mandant der WKF-Sage. Sage-100-Tabellen filtern über diese Spalte.
mandant = 1

# Zusätzliche ODBC-Schlüssel, falls der Treiber sie braucht:
# [sage.extra]
# Encrypt = "yes"
# TrustServerCertificate = "yes"

[export]
# Ziel der Shop-Verzeichnisse, relativ zu dieser Datei.
# In der App als SYNC_SOURCE_DIR auf denselben Pfad zeigen.
root = "export"

# Verschachtelte Stücklisten auflösen und Mengen multiplizieren.
# Standard aus: erst prüfen, ob Sage überhaupt mehrstufig liefert.
explode_bom = false

# Sortimentsart Präsent, gleich für jeden Shop. Keine Zuordnung Set → Domain.
# Probe Mandant 2: 8240060 African-Spice-Box ist Artikelgruppe 800 und
# USER_Auswertungsgruppe 0. Dieselbe Artikelgruppe 800 mit Auswertungsgruppe
# 80000 sind Weinpakete (8990070). 80100/880 nicht übernehmen: 8240060 liegt nicht dort.
article_groups = ["800"]
evaluation_groups = [0]

# Jeder Shop bekommt denselben gefilterten Satz. Der Ordnername ist die Domain.
[shops]
# Entweder nur die Domain, oder Domain plus Preisliste:
# [shops.WKF]
# domain = "praesentetesting.myshopify.com"
# liste_id = 12
WKF = "praesentetesting.myshopify.com"
