# Zugangsdaten der WKF-Sage. Kopie als .env anlegen — .env ist gitignored.
# Dieselben Namen wie im Vinsecco-Zugriff auf dieselbe Sage, damit ein Rechner
# nicht zwei Sätze Zugangsdaten pflegen muss.

WKF_SERVER=sql.intern.wkf
WKF_DATABASE=OL_WKF
WKF_UID=sage_readonly
WKF_PWD=

# Fallback-Namen, falls auf dem Rechner schon die generischen gesetzt sind.
# Vorrang: WKF_* vor DB_*.
# DB_SERVER=
# DB_NAME=
# DB_USER=
# DB_PASSWORD=

# Statt Server und Datenbank eine vorkonfigurierte ODBC-Datenquelle:
# WKF_DSN=WKF_SAGE

# Treiber. Standard: Windows "SQL Server", sonst "ODBC Driver 18 for SQL Server".
# TrustServerCertificate=yes setzt der Exporter selbst.
# WKF_DRIVER=ODBC Driver 18 for SQL Server

# Windows-Anmeldung statt Benutzer und Passwort:
# WKF_TRUSTED_CONNECTION=1

# Mandant der WKF-Sage. Steht sonst in sage-export.toml.
# WKF_MANDANT=1
